# =============================================================================
# .env.example — Pivovar Zajíc (minipivovar app)
# =============================================================================
# Zkopíruj tento soubor jako .env  (Windows:  copy .env.example .env)
# a doplň VLASTNÍ hodnoty. Tento soubor smí obsahovat POUZE zástupné hodnoty.
#
# ⚠️  BEZPEČNOST — TOTO NIKDY NEKOMMITUJ:
#  • .env (a .env.local) jsou v .gitignore a NESMÍ se nikdy dostat do gitu.
#  • Žádné skutečné klíče (service role, access token, webhook secret,
#    API klíče třetích stran) se nikdy neposílají do repository, ani
#    jako "dočasně". Skutečné hodnoty patří jen do lokálního .env,
#    do secrets manageru hostingu (Render/Fly/Netlify) a do Supabase
#    projektových secretů.
#  • Klíče začínající VITE_ jsou Vite vkládány do klientského JS bundle
#    (jsou tedy veřejné). Nikdy sem nedávej service role klíč.
#
# Hodnoty níže jsou ukázkové zástupné hodnoty — zadej vlastní!

# -----------------------------------------------------------------------------
# POVINNÉ — webová aplikace (Vite / klient)
# Čtou se v src/lib/supabase.ts přes import.meta.env.VITE_*
# -----------------------------------------------------------------------------

# URL Supabase projektu. Vytvořit v Supabase Dashboard -> Project Settings.
VITE_SUPABASE_URL=https://xxxx.supabase.co

# Veřejný (anon) klíč Supabase. Rovněž z Dashboard -> Project Settings -> API.
# Je vložen do JS bundle, takže je z podstaty veřejný — ale přesto ho drž
# mimo git (jiné projekty ho nepotřebují).
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxx

# -----------------------------------------------------------------------------
# VOLITELNÉ / DEV — lokální skripty a edge funkce
# (bez hodnoty se dev skripty ohlásí chybou, prod běží na serverových secrets)
# -----------------------------------------------------------------------------

# Service role klíč — POUZE pro serverové skripty / edge funkce / bridge.
# NIKDY ho nedávej do VITE_* (Vite by ho vložil do veřejného bundle).
# Používají ho skripty v scripts/ (čtou z .env přes VITE_SUPABASE_SERVICE_ROLE_KEY)
# a edge funkce (jako SUPABASE_SERVICE_ROLE_KEY, viz níže).
VITE_SUPABASE_SERVICE_ROLE_KEY=

# Supabase Management API access token (sbp_...) — deploy edge funkcí
# (scripts/deploy-function.mjs, set-webhook-secret.mjs, check-token.mjs...).
SUPABASE_ACCESS_TOKEN=sbp_xxxx

# Kratší alias pro access token používaný částí skriptů (alias SUPABASE_ACCESS_TOKEN).
SB_TOKEN=

# Sdílené tajemství webhooku WhatsApp bridge (edge funkce whatsapp-webhook
# ověřuje hlavičku x-webhook-token). Musí souhlasit s projektovým secretem
# na Supabase i s proměnnou bridge na Renderu/Fly.
WEBHOOK_SECRET=

# API klíč Renderu (pouze pokud se používá Render API skript pro restart deploye).
RENDER_API_KEY=

# -----------------------------------------------------------------------------
# Edge funkce (supabase/functions/*/index.ts) — nastavují se v Supabase
# Dashboard -> Edge Functions -> Secrets (Deno.env.get), nikoli do .env klienta.
# Uvedeny zde jen jako dokumentace pro lokální vývoj (supabase functions serve).
# -----------------------------------------------------------------------------

# URL Supabase projektu (edge funkce; obvykle stejná hodnota jako VITE_SUPABASE_URL).
SUPABASE_URL=https://xxxx.supabase.co

# Anon klíč pro edge funkce, které volají REST API jako klient (např. analyze-reviews).
SUPABASE_ANON_KEY=

# Service role klíč pro edge funkce (zápis do whatsapp_session apod.).
SUPABASE_SERVICE_ROLE_KEY=

# Adresa webhook edge funkce pro WhatsApp bridge; pokud chybí, odvodí se z SUPABASE_URL.
WEBHOOK_URL=https://xxxx.supabase.co/functions/v1/whatsapp-webhook

# Volitelné limity kontextu pro AI parsování objednávek v edge funkcích.
CONTEXT_MAX_DAYS=7
CONTEXT_MAX_MESSAGES=200

# -----------------------------------------------------------------------------
# WhatsApp bridge (whatsapp-bridge/) — viz whatsapp-bridge/.env.example
# -----------------------------------------------------------------------------

# Povolené WhatsApp skupiny (čárkou oddělené), default: Objednávky pivovar.
ALLOWED_GROUPS=

# Povolení kontakty mimo skupiny (čárkou oddělené).
ALLOWED_CONTACTS=

# Úroveň logování bridge: info | debug | warn | error.
LOG_LEVEL=info

# Port health endpointu bridge.
PORT=3000

# Supabase Storage bucket pro fotky z WhatsApp objednávek.
WHATSAPP_MEDIA_BUCKET=whatsapp-media

# Historie zpráv: stáří (dny) a max počet zpráv přeposílaných po připojení.
HISTORY_MAX_DAYS=4
HISTORY_MAX_MESSAGES=1000

# -----------------------------------------------------------------------------
# ADRESÁŘE SE SKUTEČNÝMI HODNOTAMI — NIKDY NEKOMMITOVAT
# -----------------------------------------------------------------------------
#  • root/.env                    — vše výše (gitignored)
#  • whatsapp-bridge/.env         — bridge proměnné (gitignored)
#  • Supabase projektové secrets  — edge funkce (Dashboard -> Secrets)
#  • Render/Fly/Netlify env       — hosting secrets
