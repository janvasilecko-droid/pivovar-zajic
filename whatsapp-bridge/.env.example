# ── WhatsApp Gateway — příklad konfigurace ─────────────────────────────
# Zkopíruj do .env (nebo nastav v Renderu jako environment variables).

# URL Supabase projektu (hodnota z .env v rootu repo: VITE_SUPABASE_URL)
SUPABASE_URL=https://sasqexjadvlqyticxwja.supabase.co

# Service role klíč (hodnota z .env v rootu repo: VITE_SUPABASE_SERVICE_ROLE_KEY)
# Potřebný pro zápis WhatsApp session do tabulky whatsapp_session.
SUPABASE_SERVICE_ROLE_KEY=

# Adresa naší edge funkce (pokud se nevyplní, odvodí se z SUPABASE_URL)
WEBHOOK_URL=https://sasqexjadvlqyticxwja.supabase.co/functions/v1/whatsapp-webhook

# Sdílené tajemství webhooku (hodnota z .env v rootu repo: WEBHOOK_SECRET)
# Bez správné hlavičky x-webhook-token vrací webhook HTTP 401.
WEBHOOK_SECRET=

# Sdílené tajemství pro POST /send (appka žádá bridge o odeslání zprávy ven,
# např. shrnutí nové objednávky do skupiny). Bez správné hlavičky
# x-send-token vrací /send HTTP 401. Vygeneruj náhodný řetězec a stejnou
# hodnotu ulož i jako Supabase secret WHATSAPP_SEND_TOKEN.
SEND_TOKEN=

# Povolené skupiny (čárkou oddělené) — podle názvu skupiny
ALLOWED_GROUPS=Objednávky pivovar

# Povolení kontakty (čárkou oddělené) — mimo skupiny (1:1 konverzace)
ALLOWED_CONTACTS=Ala Milacek Milacek

# Úroveň logování: info | debug | warn | error
LOG_LEVEL=info

# Port health endpointu (Render Web Service ho používá pro health check)
PORT=3000

# Supabase Storage bucket pro fotky z WhatsApp objednávek (DeepSeek fotky nečte,
# takže se fotka stáhne a uloží sem — v aplikaci ji pak lze zobrazit/stáhnout).
# Bucket vytvoří i migrace 20261010000000_add_whatsapp_media_bucket.sql;
# služba si ho případně vytvoří sama při startu.
# WHATSAPP_MEDIA_BUCKET=whatsapp-media

# Maximální stáří zpráv z historie (ve dnech), které se mají po připojení přeposlat.
# Výchozí hodnota je 4 dny (0 = bez omezení stáří).
# HISTORY_MAX_DAYS=4

